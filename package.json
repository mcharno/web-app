{
  "name": "web-app",
  "version": "1.0.0",
  "description": "Personal website web application",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.11.0",
  "scripts": {
    "dev": "concurrently \"yarn workspace charno-backend dev\" \"yarn workspace frontend dev\"",
    "start": "concurrently \"yarn workspace charno-backend start\" \"yarn workspace frontend start\"",
    "test": "yarn workspaces foreach -pt run test",
    "test:watch": "concurrently \"yarn workspace charno-backend test:watch\" \"yarn workspace frontend test:watch\"",
    "build": "yarn workspace frontend build",
    "install:all": "yarn install",
    "comic-admin": "node scripts/comic-admin.js",
    "test:scripts": "node --test scripts/comic-admin.test.js",
    "validate-gallery": "node scripts/validate-gallery.js",
    "upload-photos": "bash scripts/upload-photos.sh"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "keywords": [
    "personal-website",
    "portfolio"
  ],
  "author": "Michael Charno",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
